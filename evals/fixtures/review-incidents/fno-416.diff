diff --git a/crates/fno/config.example.toml b/crates/fno/config.example.toml
index bc24b5dd17..2d8462ef7a 100644
--- a/crates/fno/config.example.toml
+++ b/crates/fno/config.example.toml
@@ -858,6 +858,24 @@ alert_notification = true
 # The Dock badge showing the count of blocked agents in fno-app (default on).
 alert_badge = true
 
+[provider_cap]
+# Arm the provider cap actor: a lane that hits its usage cap alerts its leads, and its members park until the reset (default on). Off still measures and saves the snapshot, and moves nothing.
+enabled = true
+# What a capped lane does with its members: park (default; alert the leads, move nothing, resume after the reset) | triage (a member on a p0 or p1 node, or with an open PR, moves to destinations; the rest park) | ask (nothing moves until an operator answers; inside sleep_hours it moves without a question) | auto (every member moves without a question).
+mode = "park"
+# Route lanes a moving member tries in order when no fallback grid is set. Empty by default: moving work spends another paid lane, so only an operator names one.
+destinations = []
+# A reset closer than this many minutes is waited out and never moved (default 30).
+min_wait_minutes = 30
+# Window as HH:MM-HH:MM, read in sleep_timezone. In ask mode a cap inside the window moves members without a question. Empty (default) means never asleep.
+sleep_hours = ""
+# IANA zone for sleep_hours, for example America/Los_Angeles. Empty (default) reads the machine's local zone.
+sleep_timezone = ""
+# Minutes a canary session must live after the reset before the return ladder resumes the parked members (default 15).
+canary_survive_minutes = 15
+# Members on one lane with a fresh capped tail needed to open it (default 2). One member suffices when its 429 names a reset still ahead, or when the account's runtime-state quota lock is set.
+quorum = 2
+
 [dev]
 # Maintainer pin: a checkout root the Rust bootstrap re-provisions from (uv tool install <path>/cli) when its tool venv is wiped. Unset = the frozen 0.4.8 wheel self-provision (legacy end-user default).
 source = ""
